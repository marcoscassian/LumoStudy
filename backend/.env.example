# =========================
# LumoStudy - Backend
# =========================

# --- Aplicação / autenticação ---
# Gere uma chave longa e aleatória antes de publicar o backend.
JWT_SECRET=troque_esta_chave_em_producao
JWT_EXPIRE_MINUTES=10080

# Origem pública do frontend usada no CORS e nos links de recuperação.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Recuperação de senha por e-mail ---
# Gmail: porta 587 + TLS. EMAIL_PASSWORD deve ser uma senha de app.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=lumostudy934@gmail.com
EMAIL_PASSWORD=COLOQUE_A_SENHA_DE_APP_AQUI
EMAIL_FROM_NAME=LumoStudy
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
RESET_TOKEN_MINUTES=30

# --- Banco local (desenvolvimento) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=icaro
MYSQL_DATABASE=lumostudy
MYSQL_CHARSET=utf8mb4
AUTO_CREATE_DATABASE=true

# --- Banco online/gerenciado ---
# Em produção, prefira DATABASE_URL. Quando ela estiver definida, os campos
# MYSQL_HOST/PORT/USER/PASSWORD acima deixam de ser a fonte principal.
# Exemplo:
# DATABASE_URL=mysql+pymysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# AUTO_CREATE_DATABASE=false

# Alguns provedores exigem CA para TLS. Deixe vazio se o serviço não exigir.
# MYSQL_SSL_CA=C:/caminho/para/ca.pem
# MYSQL_SSL_VERIFY=true
